#!/usr/bin/env python3
"""dev/feedback-watch — waits until a feedback issue needs Claude, prints it, exits.

For the Claude thread that handles feedback (docs/feedback-agent.md): it runs
this in the background and wakes when it exits. A feedback needs Claude when
it is open and the user wrote last: a new issue, or a reply after Claude's
last comment (Claude's comments carry the aiterm-feedback marker). Nothing is
stored: once Claude comments, the issue stops showing up.

  dev/feedback-watch               wait, then print one line per issue
  dev/feedback-watch --once        print what needs Claude now and exit
  dev/feedback-watch --interval 30 seconds between checks (default 30)

Only issues and comments of the repository owner count. Uses the user's gh;
GitHub answers "not changed" to most checks (ETag)."""

import argparse
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src"))

from aiterm import feedback  # noqa: E402


def line(item):
    last = item.messages[-1]
    what = "new" if len(item.messages) == 1 else "reply"
    text = " ".join(last.text.split())
    return f"#{item.number} {what}: {item.title}" + (f" — {text[:200]}" if what == "reply" else "")


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--interval", type=float, default=30)
    args = parser.parse_args()
    tracker = feedback.Tracker(creator=feedback.OWNER, open_only=True)
    failures = 0
    while True:
        try:
            pending = [item for item in tracker.poll() if item.needs_claude]
            failures = 0
        except feedback.GhError as error:
            failures += 1
            print(f"feedback-watch: {error}", file=sys.stderr)
            if args.once or failures >= 20:  # ~10 minutes of errors: let the thread see it
                return 1
            pending = []
        if pending or args.once:
            for item in sorted(pending, key=lambda i: i.number):
                print(line(item), flush=True)
            return 0
        time.sleep(args.interval)


if __name__ == "__main__":
    sys.exit(main())
