#!/usr/bin/env bash
# aiterm-left — shows the agent what is in the user's terminal.
#   aiterm-left        the last command, its output and exit code
#   aiterm-left N      the last N commands
#   aiterm-left all    the whole terminal, including scrollback
#
# The first line is always the terminal's current folder. Works for the agent
# started by Aiterm (AITERM_WINDOW is set): it asks the app over D-Bus
# (src/aiterm/tools.py, src/aiterm/dbus_api.py).
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m aiterm.tools left "$@"
