#!/usr/bin/env bash
# aiterm — the AI terminal: your shell in tabs, the agy agent in the panel on
# the right (Alt+Enter). Runs the Python app from this repository; no build step.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m aiterm "$@"
