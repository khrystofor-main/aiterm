#!/usr/bin/env bash
# aiterm-run — runs a command in the user's terminal, in plain sight, waits for
# it to finish and returns its output and exit code to the agent.
#   aiterm-run 'command'          type the command and wait for it (up to 60 s)
#   aiterm-run -t 600 'command'   wait longer (apt, builds, downloads)
#   aiterm-run -w                 type nothing, just wait for the running command
#
# Exit codes: 0 done, 1 not inside aiterm, 2 usage, 3 terminal busy
# (the user is typing or a program is running), 124 still running after the timeout.
# Talks to the Aiterm app over D-Bus (src/aiterm/tools.py, src/aiterm/dbus_api.py).
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m aiterm.tools run "$@"
